# Kinara server settings. Kept when Kinara is upgraded. After a change:
#   launchctl kickstart -k gui/$(id -u)/media.kinara.server
# Every setting is listed in `/usr/local/kinara/kinara-server -h` and the
# server's README.

# Database and settings, and the cache (artwork, converted video, preview
# thumbnails; it can grow large, so put it on a big disk if you like).
# Default: ~/Library/Application Support/Kinara and ~/Library/Caches/Kinara.
# KINARA_DATA=/Volumes/Media/Kinara
# KINARA_CACHE=/Volumes/Media/Kinara/cache

# Address and port for the apps and the web app.
KINARA_LISTEN=:8420

# Your own TMDB key, instead of the one built in.
# KINARA_TMDB_KEY=

# Converting: videotoolbox (the Mac's own hardware encoder), or none for the
# CPU only. auto picks VideoToolbox when it works.
# KINARA_HWACCEL=auto

# Kinara account and remote play. off turns both off.
# KINARA_CLOUD_URL=https://cloud.kinara.media

# Port for direct HTTPS from outside your home (after linking a Kinara account).
# KINARA_HTTPS_PORT=32443
