<?xml version="1.0" encoding="utf-8"?>
<!-- The Kinara installer's pages and checks. build.sh fills in ${VERSION}. -->
<installer-gui-script minSpecVersion="2">
  <title>Kinara Server</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <!-- Native on Apple silicon and Intel (no Rosetta prompt). -->
  <options customize="never" require-scripts="true" hostArchitectures="x86_64,arm64"/>
  <domains enable_localSystem="true"/>
  <volume-check>
    <allowed-os-versions>
      <os-version min="12.0"/>
    </allowed-os-versions>
  </volume-check>
  <choices-outline>
    <line choice="media.kinara.server"/>
  </choices-outline>
  <choice id="media.kinara.server" visible="false" title="Kinara Server">
    <pkg-ref id="media.kinara.server"/>
  </choice>
  <pkg-ref id="media.kinara.server" version="${VERSION}" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
