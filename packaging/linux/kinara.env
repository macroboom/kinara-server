# Kinara server settings, read when the service starts:
#   sudo systemctl restart kinara-server
# This file is kept when Kinara is upgraded. Every setting is listed in
# `kinara-server -h` and the server's README.

# Database and settings, and the cache (artwork, converted video, preview
# thumbnails; it can grow large, so put it on a big disk if you like). To
# move one: make the folder, `sudo chown kinara:kinara` it, and allow the
# service to write there with `sudo systemctl edit kinara-server`:
#   [Service]
#   ReadWritePaths=/mnt/big/kinara-cache
KINARA_DATA=/var/lib/kinara
KINARA_CACHE=/var/cache/kinara

# Address and port for the apps and the web app.
KINARA_LISTEN=:8420

# The web app.
KINARA_WEB=/usr/share/kinara/web

# Your own TMDB key, instead of the one built in.
# KINARA_TMDB_KEY=

# Graphics card for converting: auto, nvenc, qsv, vaapi, or none (CPU only).
# KINARA_HWACCEL=auto

# Kinara account and remote play. off turns both off.
# KINARA_CLOUD_URL=https://cloud.kinara.media

# Port for direct HTTPS from outside your home (after linking a Kinara account).
# KINARA_HTTPS_PORT=32443
