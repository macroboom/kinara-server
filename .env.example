# Copy to .env and fill in. Values here are read at startup; variables
# already set in your shell take priority.

# TMDB read access token (the long one starting with eyJ) or v3 API key.
KINORA_TMDB_KEY=

# Where the database and image cache live.
KINORA_DATA=./kinora-data

# Address to listen on.
KINORA_LISTEN=:8420

# Path to ffprobe, if it isn't on your PATH.
# KINORA_FFPROBE=C:\ffmpeg\bin\ffprobe.exe

# Files read by ffprobe at once during a scan. Leave unset and Kinora picks
# it from the drive type (SSD: one per CPU up to 8, hard drive: 2).
# KINORA_SCAN_WORKERS=8
